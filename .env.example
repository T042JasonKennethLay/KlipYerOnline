# Salin jadi .env lalu isi. File .env tidak ikut di-commit.
# Isi salah satu (atau dua-duanya). Urutan coba: Claude, lalu Gemini, lalu heuristik.
# Tanpa key apa pun pipeline tetap jalan, tapi pakai pemilihan clip heuristik.

# Claude API, bayar per pemakaian (terpisah dari langganan Claude Pro): console.anthropic.com
ANTHROPIC_API_KEY=
# CLIP_LLM_MODEL=claude-opus-5-5

# Gemini API, ada free tier: aistudio.google.com -> Get API key
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
